# Taxpayer Satisfaction Survey destinations (Google Apps Script / Power Automate URL)
NRS_TAXPAYER_WEBHOOK_URL=
NRS_TAXPAYER_WEBHOOK_URL_BACKUP=

# STAFF Service Optimization Checklist destinations
NRS_SPAFF_WEBHOOK_URL=
NRS_SPAFF_WEBHOOK_URL_BACKUP=

# Access code the CSQAU checker enters to unlock scoring on /staff (set a real value only in .env.local / Vercel)
CSQAU_ACCESS_CODE=

# Optional: repoint the printed QR short links (/t and /s). Absolute https:// URL or a path starting with "/".
# Unset = /taxpayer and /staff.
SHORTLINK_TAXPAYER_URL=
SHORTLINK_STAFF_URL=

# Neon Postgres connection string (pending/scored staff checklist visits). Server-only.
# Use a separate dev database/branch locally; never commit a real value.
DATABASE_URL=
